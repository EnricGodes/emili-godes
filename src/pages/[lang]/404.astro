---
import Base from '../../layouts/Base.astro';
import { useT, type Lang } from '../../i18n';
import { langPaths } from '../../lib/paths';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = useT(lang);
---
<Base lang={lang} title={t('notfound.title')} description={t('notfound.text')} path="404/" noindex>
  <section class="eg-404 eg-container">
    <p class="eg-kicker">404</p>
    <h1>{t('notfound.title')}</h1>
    <p class="eg-lead" style="margin:0 auto">{t('notfound.text')}</p>
    <p style="margin-top:28px"><a class="eg-btn eg-btn--solid" href={`/${lang}/`}>{t('notfound.home')}</a></p>
  </section>
</Base>
