---
import { useT, type Lang } from '../i18n';
import { PAGES, pagePath } from '../lib/site';
import LangSwitch from './LangSwitch.astro';
interface Props { lang: Lang; path: string; alternates?: Record<Lang, string> }
const { lang, path, alternates } = Astro.props;
const t = useT(lang);
const base = `/${lang}/`;
const links = PAGES.filter((p) => p.footer);
---
<footer class="eg-footer">
  <div class="eg-container eg-footer__grid">
    <div class="eg-footer__about">
      <div class="eg-brand">Emili Godes</div>
      <p>{t('footer.note')}</p>
    </div>
    <nav class="eg-footer__nav" aria-label={t('ui.menu')}>
      {links.map((p) => <a href={pagePath(lang, p.id)}>{t('nav.' + p.id)}</a>)}
    </nav>
    <div class="eg-footer__lang">
      <LangSwitch lang={lang} path={path} alternates={alternates} variant="list" />
    </div>
  </div>
  <div class="eg-container eg-footer__bottom">
    <small>{t('footer.copyright')}</small>
    <nav class="eg-footer__legal" aria-label={t('footer.legal')}>
      <a href={pagePath(lang, 'legal')}>{t('footer.legal')}</a>
      <a href={pagePath(lang, 'privacy')}>{t('footer.privacy')}</a>
      <a href={pagePath(lang, 'cookies')}>{t('footer.cookies')}</a>
      <button type="button" data-cookie-settings>{t('footer.cookieSettings')}</button>
    </nav>
  </div>
</footer>
