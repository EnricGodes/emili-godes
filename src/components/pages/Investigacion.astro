---
import Base from '../../layouts/Base.astro';
import { pagePath, pageAlternates } from '../../lib/site';
import { useT, type Lang } from '../../i18n';
import { article, breadcrumb } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const t = useT(lang);
const base = `/${lang}/`;
const title = t('seo.investigacion.title');
const description = t('seo.investigacion.description');

/** Bibliografía: las referencias se citan en su lengua original (no se traducen). */
const BIBLIO: { group: string; items: string[] }[] = [
  { group: 'investigacion.035', items: [
    'Farré Brufau, Marisol (1986). <em>Un fotógrafo catalán de la Nueva Objetividad: Emili Godes (1895-1970)</em>. Tesis de licenciatura, Facultat de Belles Arts, Universitat de Barcelona. Inédita; consultable en la Biblioteca de la UB (Dipòsit de Cervera, sig. T 44): <a href="https://cercabib.ub.edu/discovery/fulldisplay?docid=alma991011628799706708&amp;vid=34CSUC_UB:VU1" rel="noopener">ficha del catálogo</a>.',
    'Foix, Laia (2014). <em>Modernidad y vanguardias fotográficas en la obra de Emili Godes</em>. Trabajo final de posgrado, Escuela Superior de Archivística y Gestión de Documentos. <a href="/assets/tfg-laia-foix.pdf">PDF</a>.',
    '<em>Emili Godes. Fotògraf de la Nova Objectivitat</em> (1996). Barcelona: Actar / Departament de Cultura de la Generalitat de Catalunya. Dir. David Balsells; comisarios J. Rigol y D. Giralt-Miracle.',
    '«Documentándonos sobre… Emili Godes» (c. 2004). Dossier de la Biblioteca y Centro de Documentación de ARTIUM, Centro-Museo Vasco de Arte Contemporáneo, Vitoria-Gasteiz. <a href="https://web.archive.org/web/20140111183826/http://librivision.artium.org/dossieres/AR00078/GodesEmili.pdf" rel="noopener">PDF archivado</a>.',
    '«Emili Godes i Hurtado». <em>Gran Enciclopèdia Catalana</em>. <a href="https://www.enciclopedia.cat/gran-enciclopedia-catalana/emili-godes-i-hurtado" rel="noopener">enciclopedia.cat</a>.',
    '<em>Huesca Imagen</em> (1995). Zaragoza: Diputación de Huesca. Incluye la exposición «Emili Godes», comisariada por Juan Naranjo.',
  ] },
  { group: 'investigacion.036', items: [
    '<em>Fotografías de Emilio Godes</em> (1944). Catálogo de la exposición, Galería de Arte El Jardín, Barcelona, 23 de diciembre de 1944 – 5 de enero de 1945.',
    '<em>Photographies catalanes des années trente</em> (1982). Centre d’Études Catalanes, París, noviembre de 1982. Comisarios: Joan Fontcuberta y Cristina Zelich. Barcelona: Departament de Cultura de la Generalitat de Catalunya.',
    '<em>Idas y caos. Aspectos de las vanguardias fotográficas en España</em> (1984). Comisario: Joan Fontcuberta. Madrid: Ministerio de Cultura.',
    '<em>Les avantguardes fotogràfiques a Espanya 1925-1945</em> (1997). Comisario: Juan Naranjo. Barcelona: Fundació «la Caixa».',
    '<em>Praha Paris Barcelona: modernitat fotogràfica de 1918 a 1948</em> (2010). Dir. David Balsells y Juan Naranjo. Barcelona: MNAC; Madrid: La Fábrica.',
  ] },
  { group: 'investigacion.037', items: [
    '«Los artistas catalanes en Huelva» (1930). <em>El Progreso Fotográfico</em>, n.º 117.',
    'Gasch, Sebastià (1938). «Emili Godes». <em>Meridià</em>.',
    'Sindreu, Carlos (1955). «Bajo el lente multiplicador: los aciertos intuitivos de Emilio Godes, mago de la fotomicrografía catalana». <em>El Español</em>.',
    'Sindreu, Carlos (1956). «Monstruos insospechados». <em>Diario de Barcelona</em>.',
    'Sindreu, Carlos (1963). «Monstruos en primavera». <em>San Jorge</em>, n.º 49, enero, pp. 32-37.',
    'A. (s. f.). «Descubrimiento del mundo. E. Godes y la fotografía a gran escala».',
  ] },
  { group: 'investigacion.039', items: [
    '<em>Sabadell</em>, 24 de abril de 1948, p. 3. Exposición de microfotografías de Emilio Godés.',
    '<em>La Vanguardia Española</em>, 21 de febrero de 1970, p. 31. Necrológica.',
    '<em>El País</em>, 25 de octubre de 1982, p. 54. Exposición <em>Photographies catalanes des années trente</em> en París.',
    '«La maravilla objetiva». <em>La Vanguardia</em>, 3 de mayo de 1996, pp. 43-44. Crítica de la exposición de la Primavera Fotogràfica.',
    '<em>El Periódico de Catalunya</em>, 17 de septiembre de 1997, p. 27. <em>Les avantguardes fotogràfiques a Espanya 1925-1945</em>.',
    '<em>El País</em>, 16 de diciembre de 1997, p. 35, y <em>La Vanguardia</em>, 16 de diciembre de 1997, p. 37. <em>Primer acte. La fotografia al museu</em> (MNAC).',
    '<em>Diari de Tarragona</em>, 20 de abril de 1999, p. 50. <em>Primer acte</em> en Tarragona.',
    '<em>La Vanguardia</em>, 10 de julio de 2002, p. 115. <em>Manos</em> (c. 1930), Colección Ordóñez-Falcón de Fotografía.',
  ] },
  { group: 'investigacion.038', items: [
    'González, Antonio Jesús (2006). <em>La Mezquita de plata. Un siglo de fotógrafos y fotografías de Córdoba. 1840-1939</em>. Córdoba: Fundación Botí.',
    'López Mondéjar, Publio (1999). <em>Historia de la fotografía en España</em>. 4.ª ed. Barcelona: Lunwerg, p. 126.',
    'Torrella, Rafael (2008). <em>El registre fotogràfic de Montjuïc, 1915-1923. La metamorfosi d’una muntanya</em>. Barcelona: Arxiu Històric de la Ciutat de Barcelona.',
    'Torres, José Manuel (2001). <em>La retina del sabio</em>. Santander: Universidad de Cantabria.',
    'Verdú Peral, Ana (2002). «El documento fotográfico y el archivo. La sección fotográfica del Archivo Municipal de Córdoba». En <em>Primeras Jornadas Imagen, Cultura y Tecnología</em>. Madrid: Universidad Carlos III, pp. 87-98.',
    '<em>Enciclopedia gráfica del siglo XX</em> (1983). Madrid: Ediciones Urbión.',
  ] },
];
---
<Base lang={lang} title={title} description={description} path={pagePath(lang, 'investigacion').slice(4)} alternates={pageAlternates('investigacion')} activeNav="investigacion" ogType="article"
  jsonLd={[article(lang, { url: pagePath(lang, 'investigacion'), headline: title, description }), breadcrumb([{ name: t('breadcrumb.home'), url: base }, { name: t('nav.investigacion'), url: pagePath(lang, 'investigacion') }])]}>
  <section class="eg-section">
  <div class="eg-container eg-container--narrow">
  <p class="eg-kicker">{t('investigacion.010')}</p>
  <h1 class="eg-page-title">{t('investigacion.030')}</h1>
  <div class="eg-lead" set:html={t('investigacion.031')} style="margin-top:18px"></div>
  </div>
  </section>

  <section class="eg-section eg-section--tint">
  <div class="eg-container eg-container--narrow">
  <h2 style="font-size:1.6rem">{t('investigacion.023')}</h2>
  <p class="eg-note">{t('investigacion.024')}</p>
  <div class="eg-prose" set:html={t('investigacion.025')} style="margin-top:14px"></div>
  <ul class="eg-prose" style="margin-top:4px">
  <li set:html={t('investigacion.026')}></li>
  <li set:html={t('investigacion.027')}></li>
  <li set:html={t('investigacion.028')}></li>
  </ul>
  <p class="eg-note" style="margin-top:14px">{t('investigacion.029')}</p>
  </div>
  </section>

  <section class="eg-section">
  <div class="eg-container eg-container--narrow">
  <h2 style="font-size:1.6rem">{t('investigacion.032')}</h2>
  <p class="eg-note"><em set:html={t('investigacion.021')}></em> · {t('investigacion.011')}</p>
  <div class="eg-prose" set:html={t('investigacion.001')} style="margin-top:14px"></div>

  <div class="eg-pdfbox">
  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h6"/></svg>
  <div style="flex:1;min-width:220px">
  <h3>{t('investigacion.012')}</h3>
  <p set:html={t('investigacion.022')}></p>
  </div>
  <a class="eg-btn eg-btn--primary" href="/assets/tfg-laia-foix.pdf" rel="noopener" target="_blank">{t('investigacion.013')}</a>
  <a class="eg-btn eg-btn--ghost" download href="/assets/tfg-laia-foix.pdf">{t('investigacion.014')}</a>
  </div>
  <object class="eg-pdf-viewer" data="/assets/tfg-laia-foix.pdf#view=FitH" type="application/pdf">
  <p set:html={t('investigacion.002')} style="padding:18px"></p>
  </object>
  </div>
  </section>
  <section class="eg-section eg-section--tint">
  <div class="eg-container">
  <div class="eg-grid">
  <div>
  <h3 style="font-size:1.3rem">{t('investigacion.015')}</h3>
  <div class="eg-prose" set:html={t('investigacion.003')}></div>
  </div>
  <div>
  <h3 style="font-size:1.3rem">{t('investigacion.016')}</h3>
  <div class="eg-prose" set:html={t('investigacion.004')}></div>
  </div>
  </div>
  </div>
  </section>
  <section class="eg-section">
  <div class="eg-container eg-container--narrow">
  <h3 style="font-size:1.3rem">{t('investigacion.017')}</h3>
  <ul class="eg-prose" style="margin-top:12px">
  <li set:html={t('investigacion.005')}></li>
  <li set:html={t('investigacion.006')}></li>
  <li set:html={t('investigacion.007')}></li>
  <li set:html={t('investigacion.008')}></li>
  </ul>
  <div class="eg-prose eg-mt-lg" set:html={t('investigacion.009')}></div>
  </div>
  </section>

  <section class="eg-section eg-section--tint" id="bibliografia">
  <div class="eg-container eg-container--narrow">
  <h2 style="font-size:1.6rem">{t('investigacion.033')}</h2>
  <p class="eg-note">{t('investigacion.034')}</p>
  {BIBLIO.map(({ group, items }) => (
    <>
      <h3 style="font-size:1.15rem;margin-top:26px">{t(group)}</h3>
      <ul class="eg-biblio">
        {items.map((it) => <li set:html={it}></li>)}
      </ul>
    </>
  ))}
  <div class="eg-related">
  <a href={pagePath(lang, 'biografia')}>{t('investigacion.018')}</a>
  <a href={pagePath(lang, 'exposicion')}>{t('nav.exposicion')} →</a>
  <a href={pagePath(lang, 'mirada')}>{t('investigacion.019')}</a>
  <a href={pagePath(lang, 'creditos')}>{t('investigacion.020')}</a>
  </div>
  </div>
  </section>
</Base>
