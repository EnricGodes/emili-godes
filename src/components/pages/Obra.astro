---
import Base from '../../layouts/Base.astro';
import { pagePath, pageAlternates } from '../../lib/site';
import UiJson from '../../components/UiJson.astro';
import { useT, type Lang } from '../../i18n';
import { catalog, useCatalogText, ambitoPath } from '../../lib/catalog';
import { breadcrumb } from '../../lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props as Props;
const t = useT(lang);
const base = `/${lang}/`;
const ct = useCatalogText(lang);
const title = t('seo.obra.title');
const description = t('seo.obra.description');
// versión en la URL del JSON: cada build invalida la copia cacheada en navegador/CDN
const dataVersion = Date.now().toString(36);
---
<Base lang={lang} title={title} description={description} path={pagePath(lang, 'obra').slice(4)} alternates={pageAlternates('obra')} activeNav="obra" ogImage="/photos/obra/ACP-23-1.jpg"
  jsonLd={[breadcrumb([{ name: t('breadcrumb.home'), url: base }, { name: t('breadcrumb.obra'), url: pagePath(lang, 'obra') }])]}>
  <section class="eg-section" style="padding-bottom:1.2rem">
    <div class="eg-container">
      <p class="eg-kicker">{t('obra.002')}</p>
      <h1 class="eg-page-title">{t('obra.003')}</h1>
      <div class="eg-lead" set:html={t('obra.001')}></div>
      <!-- Enlaces estáticos a las temáticas (rastreables sin JS) -->
      <nav class="eg-anchor-nav" aria-label={t('obra.themes')}>
        {ct.orderedAmbitos().map((a) => <a href={ambitoPath(lang, a)}>{ct.ambitoLabel(a)} <small>({catalog.ambitos[a].count})</small></a>)}
      </nav>
    </div>
  </section>
  <div class="eg-obra" id="eg-obra" data-src={`/data/catalog.${lang}.json?v=${dataVersion}`}>
    <aside class="eg-obra-side" id="eg-obra-side"></aside>
    <div class="eg-obra-main" id="eg-obra-main"><p class="eg-empty">{t('obra.pick')}</p></div>
  </div>
  <UiJson lang={lang} />
  <script src="../../scripts/explorer.ts"></script>
</Base>
